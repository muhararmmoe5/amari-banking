# Copy to .env.local and fill in. Never commit .env.local.

# Twilio console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number you've purchased, E.164 format (e.g. +15551234567)
TWILIO_FROM_NUMBER=

# Public HTTPS base URL Twilio can reach for webhooks (no trailing slash).
# Local dev: run `ngrok http 3000` and paste the https URL here.
# Prod: your deployed URL, e.g. https://your-app.vercel.app
PUBLIC_BASE_URL=
