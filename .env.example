# Copy to .env.local and fill in. Never commit .env.local.

# === AI assistant (optional) ===
# Get an API key at https://console.anthropic.com/settings/keys
# Without this, the "Ask AI" button still appears but every query returns a "missing API key" error.
ANTHROPIC_API_KEY=

# Override the model if you want to trade cost for speed (defaults to claude-opus-4-7).
# Cheaper options: claude-haiku-4-5  (~10× cheaper, still very capable for simple commands)
#                  claude-sonnet-4-6 (~5× cheaper than Opus)
# ANTHROPIC_MODEL=claude-opus-4-7

# === Optional ===
# Override the SQLite path. Defaults to ./data/amari.db.
# DB_PATH=./data/amari.db

# === Password reset email (optional) ===
# Without these, the /forgot-password page shows
# "Email-based reset is not configured" and admin-driven reset (via Team page)
# remains the only path.
#
# Get an API key at https://resend.com/api-keys (free for 100 emails/day).
# RESEND_API_KEY=re_...
#
# Sender address. Must be on a verified domain in your Resend account
# (Resend → Domains → verify amari.yourdomain.com). For testing without
# a domain, leave unset to use 'onboarding@resend.dev' which only delivers
# to the email tied to your Resend account.
# RESET_FROM_EMAIL=security@amari.yourdomain.com
