# Copy to .env and fill in. Never commit .env.

# Required in production. Must be >= 32 random bytes (hex/base64).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# 'development' | 'production'
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# SQLite database file path
DB_PATH=./data/bank.db

# bcrypt cost factor (12 is a sane default; raise if hardware allows)
BCRYPT_ROUNDS=12

# Set to "true" only when serving over HTTPS. Required for secure cookies in prod.
TRUST_PROXY=false
